# Переменные процесса marketplace. make dev задаёт значения для compose сам;
# этот файл — справочник для выката. Обязательные отмечены.

# обязательная: PostgreSQL маркетплейса
DATABASE_URL=postgres://marketplace:marketplace@localhost:25432/marketplace?sslmode=disable
DATABASE_MAX_CONNS=10

# общий поиск предложений: обязательные адрес и отдельный служебный токен
SEARCH_URL=http://localhost:5002
SEARCH_MARKETPLACE_TOKEN=
SEARCH_TIMEOUT=35s
SEARCH_MAINTENANCE_INTERVAL=1m

# обязательная: адреса OpenSearch геоиндекса пунктов выдачи через запятую
OPENSEARCH_URLS=http://localhost:29200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INSECURE_SKIP_VERIFY=false
OPENSEARCH_SHARDS=1
OPENSEARCH_REPLICAS=1

# обязательная: брокеры Kafka установки
KAFKA_BROKERS=localhost:29094
# префикс установки в именах топиков (KAFKA_TOPIC_PREFIX сервера)
KAFKA_TOPIC_PREFIX=
KAFKA_GROUP_ID=marketplace
KAFKA_MAX_ATTEMPTS=5
# топик событий реестра без префикса; заводит сервер установки
KAFKA_TOPIC_REFERENCE_CHANGED=catalog.reference.changed
KAFKA_TOPIC_OFFER_STATUS=marketplace.offer.status
KAFKA_TOPIC_PARTICIPANT_STATUS=marketplace.participant.status
# токен чтения реестра для бэкендов поиска и сервера: >=32 символов, не равен OPERATOR_TOKEN
REFERENCE_READ_TOKEN=

# обязательная: служебный токен операторских ручек, не короче 32 символов
OPERATOR_TOKEN=

HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=20s
LOG_LEVEL=info

OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH=100
OUTBOX_PER_TENANT=20
OUTBOX_LEASE=1m

RETENTION_PROCESSED_EVENTS=336h
RETENTION_OUTBOX_DONE=72h
RETENTION_PARKED_EVENTS=720h
RETENTION_INTERVAL=1h
RETENTION_CHALLENGES=24h

# обязательная: Redis для сессий покупателей и лимитов входа
REDIS_URL=redis://localhost:26379/0

# вход по звонку: live — шлюз sms.ru, sandbox — любой номер подтверждается сам (только разработка)
SMSRU_MODE=live
# обязательна при SMSRU_MODE=live
SMSRU_API_ID=
SMSRU_BASE_URL=https://sms.ru
# адрес оповещений о звонках; задан — регистрируется у шлюза на старте
SMSRU_CALLBACK_URL=
SMSRU_SANDBOX_CONFIRM_AFTER=10s

LOGIN_CHALLENGE_TTL=5m
LOGIN_CHECK_INTERVAL=2s
# попыток/окно
LOGIN_PHONE_LIMIT=3/10m
LOGIN_IP_LIMIT=20/1h
SESSION_TTL=720h
# брать адрес клиента из X-Forwarded-For — только за своим балансировщиком
HTTP_TRUST_PROXY=false

# обязательные: внутренний API сервера установки и токен маркетплейса к нему (не короче 32 символов)
PLATFORM_API_URL=http://localhost:5001
SERVICE_TOKEN_MARKETPLACE=
PLATFORM_API_TIMEOUT=5s

CART_TTL=720h
MARKETPLACE_PUBLIC_URL=http://localhost:8080
ORDERS_SYNC_INTERVAL=30s
# Минимальная субсидия продавца: целый процент 0–100.
DELIVERY_SUBSIDY_MIN_PERCENT=30
QUOTE_TTL=30m
QUOTE_TIMEOUT=5s

# перевозчики: без учётных данных перевозчик не подключён
CDEK_API_URL=https://api.cdek.ru
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
YANDEX_DELIVERY_API_URL=https://b2b-authproxy.taxi.yandex.net
YANDEX_DELIVERY_TOKEN=
PICKUP_REFRESH_INTERVAL=24h
OPENSEARCH_PICKUP_INDEX=marketplace-pickup-points

SETTINGS_SYNC_INTERVAL=5m

# Вход оператора платформы (все три переменные вместе; пусто — только машинный доступ).
OPERATOR_EMAIL=
OPERATOR_NAME=Оператор
# Argon2id PHC: v=19, m=65536,t=3,p=4; соль >=16 байт, хеш 32 байта.
OPERATOR_PASSWORD_HASH=
OPERATOR_ORIGIN=
OPERATOR_SESSION_TTL=8h
# Явные соответствия нативных зон ПВЗ существующим ISO 3166-2 RU, JSON-объекты.
CDEK_REGION_CODES={}
YANDEX_REGION_CODES={}

# IDH-05: backend clients зарегистрированы отдельно в realm marketplace/platform.
IDENTITY_HUB_URL=https://identity.example.invalid
IDENTITY_CLIENT_ID=marketplace-backend
IDENTITY_BACKEND_SECRET=
IDENTITY_OPERATOR_CLIENT_ID=marketplace-operator-backend
IDENTITY_OPERATOR_SECRET=
# Отдельные случайные 32 байта в base64; не совпадает с credentials клиентов.
IDENTITY_REFRESH_KEY=
IDENTITY_TIMEOUT=5s
IDENTITY_CA_FILE=

# Наблюдение за совпадениями моделей; не влияет на выдачу.
MARKETPLACE_MODEL_KEYS=false

# Отдельный токен attribute-values поиска (SEARCH_ATTRIBUTE_CANDIDATES_TOKEN у поиска).
SEARCH_CANDIDATES_TOKEN=
# Сбор кандидатов открытых словарей; 0 выключает. Без токена не запускается.
REFERENCE_CANDIDATES_INTERVAL=1h

# Часовой пояс календарных недель и соль обезличенных посетителей обязательны.
PROMOTION_TIMEZONE=Etc/UTC
PROMOTION_SEARCH_RELEVANCE_DEPTH=100
PROMOTION_EVENTS_PER_MINUTE=120
PROMOTION_TICK_INTERVAL=15m
PROMOTION_VISITOR_SALT=replace-with-random-secret
# Пусто — машинные маршруты участия и продвижения отвечают 404. Отдельный токен от 32 символов.
SERVER_API_TOKEN=

# Окно склейки пересчёта сводки магазина после индексации.
STORE_CARD_REFRESH_DELAY=30s
